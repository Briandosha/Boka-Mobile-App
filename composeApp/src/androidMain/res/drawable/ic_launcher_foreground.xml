<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- The official Boka mark (ring r=50 stroke 21 + two brass wedges, authored
         in 120-space) scaled 0.6 and centred (18px margin) so it exactly fills the
         adaptive-icon safe zone. Transparent background (set in the adaptive-icon)
         so the mark floats with no plate. -->
    <group android:translateX="18" android:translateY="18" android:scaleX="0.6" android:scaleY="0.6">
        <path android:strokeColor="#F5F2EA" android:strokeWidth="21"
              android:pathData="M10,60 A50,50 0 1 1 110,60 A50,50 0 1 1 10,60"/>
        <path android:fillColor="#C8A96B"
              android:pathData="M120.5,60 A60.5,60.5 0 0 1 60,120.5 L60,99.5 A39.5,39.5 0 0 0 99.5,60 Z"/>
        <group android:pivotX="60" android:pivotY="60" android:rotation="180">
            <path android:fillColor="#C8A96B"
                  android:pathData="M120.5,60 A60.5,60.5 0 0 1 60,120.5 L60,99.5 A39.5,39.5 0 0 0 99.5,60 Z"/>
        </group>
    </group>
</vector>
